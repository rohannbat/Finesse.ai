# Database
DATABASE_URL=postgresql://healthsync:healthsync@localhost:5432/healthsync

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=10080

# OAuth token encryption at rest (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Oura developer app — https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8000/api/integrations/oura/callback

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
